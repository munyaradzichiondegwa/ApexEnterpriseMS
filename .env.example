# Copy this file to ".env" (it is git-ignored) and fill it in. Never commit real secrets.

# Signing key for login tokens. REQUIRED outside local development. At least 32 characters, random.
#   openssl rand -base64 48
JWT_SECRET=

# Database password (must match the postgres service; use a unique value in production).
POSTGRES_PASSWORD=

# The browser-facing URLs. FRONTEND_ORIGIN is allowed to call the API (CORS); comma-separate several.
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Development (default) or Production. Production enforces the security checks described in the README.
ASPNETCORE_ENVIRONMENT=Development
