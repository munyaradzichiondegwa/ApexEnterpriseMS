<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApexERP.API</RootNamespace>
    <UserSecretsId>apexerp-api-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApexERP.Domain\ApexERP.Domain.csproj" />
    <ProjectReference Include="..\ApexERP.Application\ApexERP.Application.csproj" />
    <ProjectReference Include="..\ApexERP.Infrastructure\ApexERP.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
    <!-- Required here (not just in ApexERP.Infrastructure) because `dotnet ef` requires the
         STARTUP project (-s ApexERP.API) to directly reference Design; PrivateAssets="All" on
         Infrastructure's reference intentionally doesn't flow through to consuming projects. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
