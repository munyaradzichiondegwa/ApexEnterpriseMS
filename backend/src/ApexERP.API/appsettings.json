{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ApexERP"
  },
  "Controls": {
    "JournalApproval": {
      "AllowSelfApproval": false
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Auth": {
    "RefreshTokenCookieOnly": true,
    "CookieSameSite": "Strict"
  },
  "Security": {
    "TrustForwardedHeaders": false,
    "RowLevelSecurity": {
      "Enabled": false
    }
  },
  "Jobs": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
